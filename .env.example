# GunnersAnalysis configuration
# Copy to .env and change every password before deploying.

# --- Season warehouse -------------------------------------------------------
POSTGRES_USER=gunners
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gunners
POSTGRES_PORT=5432
# `postgres` is the compose service name, so this value is correct inside the
# containers and wrong everywhere else. Anything run with LOCAL=1 -- `make ask`,
# `make eval`, the analyst layer generally -- resolves it on the host, where the
# name does not exist, and fails with "could not translate host name". Override
# it for those runs:
#   GUNNERS_DB_URL=postgresql://gunners:change-me@localhost:5432/gunners
GUNNERS_DB_URL=postgresql://gunners:change-me@postgres:5432/gunners
GUNNERS_SEASON=2026/2027

# --- Airflow ----------------------------------------------------------------
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change-me
AIRFLOW_UID=50000
# Fixture DAGs run this many minutes after the final whistle. The whistle is
# derived as kick-off + MATCH_DURATION_MINUTES (90 + 15 interval + ~10 stoppage),
# so the default schedule is kick-off + 2h25.
POST_MATCH_DELAY_MINUTES=30
MATCH_DURATION_MINUTES=115

# The Airflow UI's host port. 8080 is a popular address; change this if another
# project already holds it.
AIRFLOW_PORT=8080

# That schedule is only as good as kickoff_uk, and most fixtures do not have
# one -- they default to 15:00, which is how MW4's DAG fired at 17:25 for a
# 20:00 kick-off. await_final_whistle waits out the difference by asking FotMob
# whether the match has actually finished. 24 x 15 min = 6 hours of patience.
WHISTLE_RETRIES=24
WHISTLE_RETRY_DELAY_MINUTES=15

# Soft-skip the DSPy analyst report rather than failing the run when the LM is
# unavailable (no credit, outage). The 18 panels render either way.
GUNNERS_REPORT_OPTIONAL=

# --- Paths / services -------------------------------------------------------
GUNNERS_ROOT=/opt/gunners

# Scraper browser: headed | xvfb | headless.
# Unset means auto: a real window if $DISPLAY exists, else Xvfb, else headless.
# Containers have no X server, so compose pins them to xvfb.
GUNNERS_BROWSER_MODE=xvfb

# WhoScored Premier League fixtures grid (season/stage ids change each year).
# Used as a fallback when Arsenal's team fixtures page has not published the id yet.
# GUNNERS_WHOSCORED_PL_FIXTURES_URL=https://www.whoscored.com/regions/252/tournaments/2/seasons/11141/stages/25544/fixtures/england-premier-league-2026-2027

# Warehouse schema. One club, one schema; gunners is Arsenal's.
GUNNERS_DB_SCHEMA=gunners
REDIS_URL=redis://redis:6379
API_PORT=8000

# --- Visualisation defaults -------------------------------------------------
BG_COLOR=#FFFFFF
LINE_COLOR=#000000
# Per-team colours come from db/loader.TEAM_COLORS at transform time.

# xT grid is cached at visualizer/assets/xT_Grid.csv so rendering works offline.
XT_GRID_URL=https://raw.githubusercontent.com/mckayjohns/youtube-videos/main/data/xT_Grid.csv

# xG and xGOT are NOT in the WhoScored feed. Leave unset and the shot map / GK
# panels render 0.0 placeholders; supply real values per match via the
# orchestrator request body or by editing data/processed/<job>/metadata.json.

# --- Football Analyst AI Agent ----------------------------------------------
# Names only. Never commit real values; .env is gitignored.

# All LLM access goes through OpenRouter via DSPy's LiteLLM backend, so model
# choice is configuration rather than code. One key, any model.
OPENROUTER_API_KEY=

# Which tier the agent runs on. Three exist, and the difference is money:
#   wiring   openai/gpt-oss-20b:free       $0            plumbing, smoke tests
#   cheap    openai/gpt-oss-20b            $0.03/$0.13   optimizer runs
#   quality  anthropic/claude-sonnet-4.5   $3/$15        final answers
# Prove the wiring on the free tier; it costs nothing and the questions it
# answers -- does retrieval return documents, does routing pick the right tool
# -- do not depend on model quality.
GUNNERS_LM_TIER=wiring

# A hard ceiling, not a warning. MIPROv2 issues hundreds to thousands of calls
# and these runs are unattended; the guard raises before crossing it.
GUNNERS_BUDGET_USD=10

# Observability. Every reasoning step is traced here.
MLFLOW_TRACKING_URI=http://localhost:5000
GUNNERS_MLFLOW_EXPERIMENT=football-analyst
MLFLOW_PORT=5000

# Local embeddings: OpenRouter serves chat only, so vectors are computed here.
# fastembed runs this through ONNX, which avoids a 2.5 GB torch install.
GUNNERS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Weekly regression DAG: the score below which the eval DAG fails loudly.
GUNNERS_EVAL_FLOOR=0.5
GUNNERS_EVAL_BUDGET=2
